# Copy to .env.local. On Vercel, set the same variables in the project settings.

# Used only by the server route that classifies unclear statement lines.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=

# Supabase (Project Settings -> API). Leave both empty to run with no login, data kept in this browser only.
# Create the table first by running supabase/schema.sql in the Supabase SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Emails allowed to use AI classification (comma-separated). Also add them to private.allowed_emails in the database.
ALLOWED_EMAIL=
